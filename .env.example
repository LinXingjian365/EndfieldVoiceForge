# ===== 提弗洛斯 AI：云端 LLM / embedding 配置 =====
# 复制本文件为 `.env`（已在 .gitignore 中，不会上传 GitHub），填入你的 key。
# 所有字段均可空；不填则对应功能在 /chat 页显示「未配置」。
# 走 OpenAI 兼容协议，DeepSeek / Qwen / SiliconFlow / Moonshot / GLM / OpenAI 均可。

# ---- LLM（对话生成）----
# 免费推荐：SiliconFlow 的免费模型 Qwen/Qwen2.5-7B-Instruct（OpenAI 兼容，注册即有免费额度）
ENDFIELD_LLM_BASE_URL=https://api.siliconflow.cn/v1
ENDFIELD_LLM_API_KEY=
ENDFIELD_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# 上游协议格式：openai（Chat Completions，默认）| anthropic（Anthropic Messages 原生，如 anyrouter）
ENDFIELD_LLM_API_FORMAT=openai

# 备选（DeepSeek 更便宜、中文好，但无 embedding 接口，需另配 embedding）：
# ENDFIELD_LLM_BASE_URL=https://api.deepseek.com/v1
# ENDFIELD_LLM_MODEL=deepseek-chat

# ---- Embedding（文本向量化，RAG 检索用）----
# 免费推荐：SiliconFlow 的 BAAI/bge-m3（免费，中文效果好）
# 若不填，自动复用上面的 LLM_BASE_URL / LLM_API_KEY
ENDFIELD_EMBED_BASE_URL=
ENDFIELD_EMBED_API_KEY=
ENDFIELD_EMBED_MODEL=BAAI/bge-m3
