+def slice_ref_audio_and_transcribe(audio_path, max_dur=10.0, min_dur=1.0):
+    """长参考音频 -> 多个 ≤max_dur 片段 + ASR 文本。返回 (HTML 预览, 文件路径列表)。"""
+    if not audio_path:
+        raise ValueError(i18n("请先上传长音频"))
+    from tools.asr.funasr_asr import only_asr
+    from tools.my_utils import load_audio
+    from tools.slicer2 import Slicer
+    from scipy.io import wavfile
+    import base64
+
+    sr = 32000
+    audio = load_audio(audio_path, sr)
+    slicer = Slicer(
+        sr=sr, threshold=-40, min_length=2000, min_interval=300, hop_size=10, max_sil_kept=500
+    )
+    base = os.path.splitext(os.path.basename(audio_path))[0]
+    out_dir = os.path.join("output", "ref_slices", base)
+    os.makedirs(out_dir, exist_ok=True)
+
+    rows = []
+    idx = 0
+    for chunk, _start, _end in slicer.slice(audio):
+        dur = len(chunk) / sr
+        pieces = []
+        if dur > max_dur:
+            step = int(max_dur * sr)
+            for i in range(0, len(chunk), step):
+                p = chunk[i : i + step]
+                if len(p) / sr >= min_dur:
+                    pieces.append(p)
+        elif dur >= min_dur:
+            pieces.append(chunk)
+
+        for piece in pieces:
+            seg_name = f"{base}_seg{idx:03d}.wav"
+            seg_path = os.path.join(out_dir, seg_name)
+            m = np.abs(piece).max()
+            if m > 1e-6:
+                piece = piece / m * 0.95
+            wavfile.write(seg_path, sr, (piece * 32767).astype(np.int16))
+            try:
+                text = only_asr(seg_path, "zh").strip()
+            except Exception:
+                text = ""
+            rows.append((seg_name, text, seg_path))
+            idx += 1
+
+    if not rows:
+        raise ValueError(i18n("未切分出有效片段，请检查音频"))
+
+    items = []
+    for i, (seg_name, text, seg_path) in enumerate(rows):
+        with open(seg_path, "rb") as f:
+            b64 = base64.b64encode(f.read()).decode()
+        items.append(
+            '<div class="ef-row">'
+            f'<span class="ef-num">{i + 1:02d}</span>'
+            f'<audio class="ef-audio" controls preload="none" src="data:audio/wav;base64,{b64}"></audio>'
+            f'<span class="ef-text">{text or "—"}</span>'
+            f'<span class="ef-fname">{seg_name}</span>'
+            "</div>"
+        )
+    css = """
+    <style>
+    .ef-slice{background:#f2f2ec;border:1px solid #d8d9d5;padding:14px;}
+    .ef-head{font-size:12px;color:#4a4c48;letter-spacing:.08em;text-transform:uppercase;border-bottom:2px solid #101110;padding-bottom:6px;margin-bottom:10px;font-family:ui-monospace,SFMono-Regular,monospace;}
+    .ef-row{display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid #d8d9d5;}
+    .ef-row:last-child{border-bottom:none;}
+    .ef-num{font-family:ui-monospace,monospace;font-variant-numeric:tabular-nums;color:#fff500;background:#101110;padding:2px 6px;min-width:24px;text-align:center;font-size:13px;}
+    .ef-audio{height:36px;flex:1;min-width:200px;}
+    .ef-text{flex:2;color:#101110;font-size:14px;line-height:1.4;}
+    .ef-fname{flex:1;color:#4a4c48;font-size:12px;font-family:ui-monospace,monospace;word-break:break-all;text-align:right;}
+    .ef-audio:focus{outline:2px solid #fff500;outline-offset:1px;}
+    </style>
+    """
+    html = (
+        f'<div class="ef-slice">{css}'
+        f'<div class="ef-head">{i18n("切分结果")} · {len(rows)} {i18n("段")}</div>'
+        f'{"".join(items)}</div>'
+    )
+    return html, [r[2] for r in rows]
+
+
+def recognize_ref_text(audio_path):
+    """识别参考音频的文本（ASR），自动填入参考文本。"""
+    if not audio_path:
+        raise ValueError(i18n("请先上传参考音频"))
+    from tools.asr.funasr_asr import only_asr
+
+    text = only_asr(audio_path, "zh").strip()
+    if not text:
+        raise ValueError(i18n("未能识别出文本，请检查音频或手动填写"))
+    return text
+
